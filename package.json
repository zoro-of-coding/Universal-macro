{
  "name": "universal-macro",
  "version": "1.0.0",
  "description": "Universal Macro - lightweight desktop automation for keyboard & mouse",
  "main": "out/main/index.js",
  "author": "Universal Macro",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "prebuild": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "package": "electron-builder --dir",
    "make:win": "electron-builder --win --x64",
    "make": "electron-builder"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "uiohook-napi": "^1.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^32.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.universalmacro.app",
    "productName": "Universal Macro",
    "npmRebuild": false,
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
